---
# ansible-lint for beamline-ansible (handbook Ch40): the strictest profile. Versions are pinned
# in ci/requirements.txt (ansible-lint 25.1.3, the newest that supports ansible-core 2.16.3, admin's).
# Every waiver is a "# noqa: <rule>" at its task, with the reason next to it.
profile: production
offline: true
exclude_paths:
  - .git/
