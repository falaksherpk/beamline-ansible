# Managed by Ansible (beamline-ansible, role k8s, Chapter 13).
# Used once, by hand: sudo kubeadm init --config /etc/kubernetes/kubeadm-init.yaml
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ k8s_api_advertise_address }}"
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "v{{ k8s_package_version.split('-') | first }}"
controlPlaneEndpoint: "{{ k8s_control_plane_endpoint }}"
networking:
  podSubnet: "{{ k8s_pod_subnet }}"
  serviceSubnet: "{{ k8s_service_subnet }}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# Serving certificate from the cluster CA through a CSR instead of a self-signed
# one (Chapter 16, D2), so Prometheus on obs can verify the kubelet on 10250.
# kubelet-serving CSRs are never auto-approved: approve each by hand, also at
# rotation (kubelet_certificate_manager_server_ttl_seconds shows the time left).
serverTLSBootstrap: true
---
# NodePorts only on lab-network addresses (Chapter 14). With the default
# (null) kube-proxy serves them on every local address, incl. nat0 and
# 127.0.0.0/8; ufw can't filter them (see the firewall task's comment).
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
nodePortAddresses:
  - "{{ k8s_lab_subnet }}"
