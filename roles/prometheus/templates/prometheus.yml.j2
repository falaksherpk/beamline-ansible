# Managed by Ansible (beamline-ansible, role prometheus) - do not edit on the host.
# Validated with promtool before it is installed; changes are applied by a reload.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

storage:
  tsdb:
    retention:
      time: {{ prometheus_retention_time }}
      size: {{ prometheus_retention_size }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ prometheus_alertmanager_address }}"]

# Alert rules, each validated by promtool check rules and unit-tested (role tasks).
rule_files:
  - {{ prometheus_config_dir }}/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ prometheus_listen_address }}"]

  - job_name: alertmanager
    static_configs:
      - targets: ["{{ prometheus_alertmanager_address }}"]

  # Every host in the Ansible inventory runs node_exporter on its lab address.
  - job_name: node
    static_configs:
      - targets:
{% for host in groups['all'] | sort %}
          - "{{ host }}:{{ prometheus_node_exporter_port }}"
{% endfor %}

  # GitLab (role gitlab), every {{ prometheus_gitlab_scrape_interval }}.
  - job_name: gitlab-rails
    scrape_interval: {{ prometheus_gitlab_scrape_interval }}
    scheme: https
    metrics_path: /-/metrics
    tls_config:
      ca_file: {{ prometheus_gitlab_ca_file }}
    static_configs:
      - targets: ["{{ groups['gitlab'][0] }}:443"]

  - job_name: gitlab-workhorse
    scrape_interval: {{ prometheus_gitlab_scrape_interval }}
    static_configs:
      - targets: ["{{ groups['gitlab'][0] }}:{{ prometheus_gitlab_workhorse_port }}"]

  - job_name: gitlab-gitaly
    scrape_interval: {{ prometheus_gitlab_scrape_interval }}
    static_configs:
      - targets: ["{{ groups['gitlab'][0] }}:{{ prometheus_gitlab_gitaly_port }}"]
