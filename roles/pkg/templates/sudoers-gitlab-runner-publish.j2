# Managed by Ansible (beamline-ansible, role pkg) - do not edit on the host.
# CI jobs on this host run as {{ pkg_runner_user }}, for every project runner registered
# here (protected refs only): beamline-healthcheck (Ch17) and tango-devices (Part 4 Ch34).
# They may publish a package from the drop directory as the repository owner: exactly
# these two commands, nothing else. A * in an argument also matches "/", so this rule
# fixes the command and the user, not the path and not the project; the trust boundary
# is who can run protected pipelines (Maintainers of those projects).
{{ pkg_runner_user }} ALL=({{ pkg_web_owner }}) NOPASSWD: /usr/local/bin/beamline-publish deb {{ pkg_publish_dropdir }}/*.deb, /usr/local/bin/beamline-publish conda {{ pkg_publish_dropdir }}/*.conda
