# Managed by Ansible (beamline-ansible, role slurm) - do not edit on the host.
# cgroup settings for Slurm, the same on every HPC node (handbook Ch18; cgroup.conf(5), Slurm 26.05.4).
CgroupPlugin=cgroup/v2
ConstrainCores=yes
ConstrainRAMSpace=yes
# A job may open only the GRES device files it was allocated (gres.conf File=; Ch20).
ConstrainDevices=yes
# The VMs have no swap, so no ConstrainSwapSpace.
