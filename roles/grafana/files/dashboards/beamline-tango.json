    {
      "type": "timeseries",
      "title": "Archived error rows per 5 min, by attribute",
      "description": "Rows stored with an error instead of a value, over every scalar table that holds data.",
      "datasource": {
        "type": "mysql",
        "uid": "hdbpp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "hdbpp"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(u.data_time, '5m'), SUBSTRING_INDEX(c.att_name, '/', -4) AS metric, COUNT(*) AS value FROM (SELECT att_conf_id, data_time FROM att_scalar_devdouble_ro WHERE att_error_desc_id IS NOT NULL AND $__timeFilter(data_time) UNION ALL SELECT att_conf_id, data_time FROM att_scalar_devdouble_rw WHERE att_error_desc_id IS NOT NULL AND $__timeFilter(data_time) UNION ALL SELECT att_conf_id, data_time FROM att_scalar_devboolean_ro WHERE att_error_desc_id IS NOT NULL AND $__timeFilter(data_time) UNION ALL SELECT att_conf_id, data_time FROM att_scalar_devboolean_rw WHERE att_error_desc_id IS NOT NULL AND $__timeFilter(data_time) UNION ALL SELECT att_conf_id, data_time FROM att_scalar_devstate_ro WHERE att_error_desc_id IS NOT NULL AND $__timeFilter(data_time) UNION ALL SELECT att_conf_id, data_time FROM att_scalar_devlong64_ro WHERE att_error_desc_id IS NOT NULL AND $__timeFilter(data_time)) u JOIN att_conf c ON c.att_conf_id = u.att_conf_id GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
