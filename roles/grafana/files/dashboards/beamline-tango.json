    {
      "type": "timeseries",
      "title": "Faraday cup current, as archived",
      "description": "Rows of linac/beam/faradaycup1/current in the archive (error rows left out).",
      "datasource": {
        "type": "mysql",
        "uid": "hdbpp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "hdbpp"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT d.data_time AS time, d.value_r AS \"faradaycup1/current (archived)\" FROM att_scalar_devdouble_ro d JOIN att_conf c ON c.att_conf_id = d.att_conf_id WHERE c.att_name LIKE '%/linac/beam/faradaycup1/current' AND d.att_error_desc_id IS NULL AND $__timeFilter(d.data_time) ORDER BY d.data_time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
